# NEET Mitos - environment template
# Copy this file to `.env` and fill in values to enable optional cloud features.
# Leave blank to run fully offline with local auth + guest mode.

# Optional: Supabase project URL (enables cloud auth / Google sign-in)
SUPABASE_URL=

# Optional: Supabase anon key
SUPABASE_ANON_KEY=

# Optional: Google OAuth server (web) client ID for Android Google sign-in
GOOGLE_SERVER_CLIENT_ID=
