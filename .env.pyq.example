# NEET Previous Year Questions Download Sources
# Add these URLs to your .env file:
# PYQ_SOURCES=[
#   {"url": "https://raw.githubusercontent.com/cursed-engineer/NEET-PYQs/main/questions.json", "label": "NEET PYQs 2015-2024", "format": "json"},
#   {"url": "https://raw.githubusercontent.com/NEET-PYQs/dataset/main/questions.json", "label": "Official NEET Dataset", "format": "json"}
# ]

# Default public sources (used if PYQ_SOURCES not set)
DEFAULT_SOURCES=[
  {
    "url": "https://raw.githubusercontent.com/cursed-engineer/NEET-PYQs/main/questions.json",
    "label": "NEET PYQs Collection",
    "format": "json",
    "description": "Comprehensive collection of NEET questions 2015-2024"
  }
]