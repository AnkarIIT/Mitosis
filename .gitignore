# 708 dependency files were committed in 343d74d before this rule existed.
node_modules/
npm-debug.log*

# Agent scratch directories.
# .manus/ was committed and contained scraped snapshots of an AUTHENTICATED
# Google Cloud Console session — including a captured titusXsrfToken — plus the
# owner's email address and project identifiers. It has been purged from git
# history; never commit it again.
.manus/
.work/

# Build artifacts, symbolication, obfuscation
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android release signing secrets (never commit)
/android/key.properties
/android/app/*.jks

# Environment secrets
.env
.env*.local
.dart-defines.local.json

# NEET PYQ downloaded PDFs (runtime downloaded or kept local)
/assets/pyq/downloaded/

.aider*
